# ==============================================================================
# Bulk Certificate Generator - Environment Configuration Template
# ==============================================================================

# Storage backend: "rustfs" (default in Docker), "local", "s3", "minio"
STORAGE_BACKEND=rustfs

# RustFS / S3 / MinIO Configuration
# When running full stack in Docker, use container network hostname "rustfs:9000".
# When running standalone Python directly on your host machine, use "http://localhost:9000".
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET_NAME=certificates
S3_REGION_NAME=us-east-1
S3_USE_SSL=false

# Local storage fallback directory
OUTPUT_DIR=/tmp/bulk_certificates_output

# Redis broker URL
# When running in Docker: redis://redis:6379/0
# When running standalone on host: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Database URL
DATABASE_URL=sqlite:///./certificates.db

# Processing Limits
MAX_RECIPIENTS_PER_BATCH=1000
MAX_PARALLEL_WORKERS=5
