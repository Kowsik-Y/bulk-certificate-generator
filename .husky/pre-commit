#!/usr/bin/env bash
# Husky Pre-Commit Hook
# Validates limits, linting, formatting, and static typing before allowing commits.

set -e

echo -e "\033[94m[Husky Pre-Commit]\033[0m Starting pre-commit quality gates..."

# Resolve Python environment
if [ -f "./venv/bin/python" ]; then
    PYTHON="./venv/bin/python"
    RUFF="./venv/bin/ruff"
    MYPY="./venv/bin/mypy"
else
    PYTHON="python3"
    RUFF="ruff"
    MYPY="mypy"
fi

# 1. Check file size limits, forbidden binaries, and secrets
echo -e "\033[94m[1/3]\033[0m Running Limit & Security Checker..."
$PYTHON scripts/check_limits.py

# 2. Check Ruff linting & code formatting
echo -e "\033[94m[2/3]\033[0m Running Ruff linter and format inspection..."
$RUFF check app tests
$RUFF format --check app tests

# 3. Check Mypy static type safety
echo -e "\033[94m[3/3]\033[0m Running Mypy type validation..."
$MYPY app

echo -e "\033[92m[Husky Pre-Commit]\033[0m All pre-commit quality checks passed! Commit allowed.\n"
